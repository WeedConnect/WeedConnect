# ──────────────────────────────────────────────────────────────────
# WeedConnect — Variables de entorno
# ──────────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore — NUNCA subas credenciales reales.
# ──────────────────────────────────────────────────────────────────

# Supabase (obligatorio para auth y base de datos)
# Encuéntralos en: Settings → API de tu proyecto en supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# URL pública del sitio (usada en metadatos Open Graph)
# En local puede dejarse vacío; en producción usa tu dominio real
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible Analytics (opcional)
# Si no lo defines, el script de analytics no se carga
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tudominio.com

# Anthropic / Claude AI (opcional, para el asistente IA)
# Encuéntralo en: console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=sk-ant-...
