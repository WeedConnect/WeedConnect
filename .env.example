# ──────────────────────────────────────────────────────────────────
# WeedConnect — Variables de entorno
# ──────────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore — NUNCA subas credenciales reales.
# ──────────────────────────────────────────────────────────────────

# Supabase (obligatorio para auth y base de datos)
# Encuéntralos en: Settings → API de tu proyecto en supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# URL pública del sitio (usada en metadatos Open Graph)
# En local puede dejarse vacío; en producción usa tu dominio real
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible Analytics (opcional)
# Si no lo defines, el script de analytics no se carga
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tudominio.com

# Anthropic / Claude AI (opcional, para el asistente IA)
# Encuéntralo en: console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=sk-ant-...

# ── Integración de lugares externos (Fase 3 — futuro) ──────────────
# Necesario solo para importar datos reales al mapa via scripts/import-places.ts
# Mientras tanto el mapa usa datos demo generados localmente

# Google Places API (dispensarios, CBD shops, negocios)
# Encuéntralo en: console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_PLACES_API_KEY=

# Foursquare Places API (spots chill, restaurantes, pubs)
# Encuéntralo en: developer.foursquare.com → My Apps
# FOURSQUARE_API_KEY=

# Activa la importación real (por defecto desactivada — usa datos demo)
# ENABLE_REAL_PLACE_IMPORT=false
